<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Trove.UI\Trove.UI.csproj" />
    <ProjectReference Include="..\..\src\Trove.Web\Trove.Web.csproj" />
  </ItemGroup>
  <Import Project="..\..\build\HopeLabThemes.targets" />

  <!-- ThemeCatalogTests read the CSS the restored package ships, which Trove's catalog has to match. -->
  <Target Name="AddHopeLabThemesMetadata" DependsOnTargets="ResolveHopeLabThemesCssFolder" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>HopeLabThemesCss</_Parameter1>
        <_Parameter2>$(HopeLabThemesCssFolder)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Bunit" />
  </ItemGroup>
</Project>
