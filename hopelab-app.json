{
  "$comment": "Read by the HopeLab Bench for its launch buttons. Trove's data and server live in CORA (served at /trove/); the desktop window opens a CORA's /trove and keeps the last board for when CORA can't be reached.",
  "launch": [
    {
      "name": "Trove desktop",
      "command": ["dotnet", "run", "--project", "src/Trove.Desktop/Trove.Desktop.csproj"],
      "default": true,
      "exclusive": true,
      "requires": [".NET SDK"]
    },
    {
      "name": "Publish for CORA",
      "command": ["dotnet", "publish", "src/Trove.App", "-c", "Release", "-o", "artifacts/trove"],
      "kind": "task",
      "requires": [".NET SDK"]
    },
    {
      "name": "Tests",
      "command": ["dotnet", "test", "Trove.slnx"],
      "kind": "task",
      "requires": [".NET SDK"]
    }
  ],
  "prerequisites": [
    {
      "name": ".NET SDK",
      "tool": "dotnet",
      "minVersion": "10.0.100",
      "why": "Trove and its desktop window target .NET 10",
      "docs": "https://dotnet.microsoft.com/download/dotnet/10.0",
      "install": { "windows": ["winget", "install", "--id", "Microsoft.DotNet.SDK.10", "--exact"] }
    }
  ]
}
