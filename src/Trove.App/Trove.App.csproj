<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Trove's app: standalone WebAssembly that CORA serves at /trove. It holds no data; every call goes to CORA's
       /trove/api, which forwards to the Trove module (see CORA's ADR-126). -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trove.UI\Trove.UI.csproj" />
  </ItemGroup>
</Project>
