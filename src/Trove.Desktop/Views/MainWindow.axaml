<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trove.Desktop.ViewModels"
        x:Class="Trove.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Trove"
        Width="1280" Height="860" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/trove.ico">
  <Panel>
    <!-- Trove itself. The web view is made in code (MainWindow.axaml.cs), once, so it keeps its page and storage
         while the window's own screens come and go over it. -->
    <Panel x:Name="WebHost" IsVisible="{Binding ShowsTrove}" />

    <!-- Start-up: checking the saved address. -->
    <StackPanel IsVisible="{Binding ShowsStarting}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <TextBlock Classes="mark" Text="◆" />
        <TextBlock Classes="brand" Text="Trove" />
      </StackPanel>
      <TextBlock Classes="muted" Text="Opening Trove…" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Connect: the first start, and Change CORA address… from Trove's Settings. -->
    <Border Classes="card" IsVisible="{Binding ShowsConnect}">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="mark" Text="◆" />
          <TextBlock Classes="brand" Text="Trove" />
        </StackPanel>
        <TextBlock Classes="h1" Text="{Binding ConnectTitle}" />
        <TextBlock Classes="muted" Text="{Binding ConnectIntro}" TextWrapping="Wrap" />
        <StackPanel Spacing="6">
          <TextBlock Text="CORA's address" FontWeight="SemiBold" />
          <TextBox x:Name="Address" Text="{Binding AddressText}" PlaceholderText="https://cora.your-tailnet.ts.net"
                   AutomationProperties.Name="CORA's address" />
          <TextBlock Classes="error" Text="{Binding ConnectProblem}" IsVisible="{Binding HasConnectProblem}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="quiet" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
          <Button Classes="primary" Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Offline: CORA can't be reached and there's no saved copy to show. -->
    <Border Classes="card" IsVisible="{Binding ShowsOffline}">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="mark" Text="◆" />
          <TextBlock Classes="brand" Text="Trove" />
        </StackPanel>
        <TextBlock Classes="h1" Text="{Binding OfflineTitle}" />
        <TextBlock Classes="muted" Text="{Binding OfflineText}" TextWrapping="Wrap" />
        <TextBlock Classes="muted small" Text="{Binding CoraOrigin}" FontFamily="{DynamicResource Lab.Font.Mono}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Classes="quiet" Content="Change CORA address…" Command="{Binding ChangeAddressCommand}" />
          <Button Classes="primary" Content="Try again" Command="{Binding RetryCommand}" IsDefault="True" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</Window>
