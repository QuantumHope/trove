<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Trove.Desktop.App"
             Name="Trove">
  <!-- Colours and faces come from the shared HopeLab themes (Lab.* keys); WindowTheme puts the one Trove's page uses
       into the resources, the same way the HopeLab Bench does. -->
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource Lab.Font.Body}" />
      <Setter Property="Background" Value="{DynamicResource Lab.Surface.Canvas}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Lab.Text.Primary}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Lab.Text.Secondary}" />
    </Style>
    <Style Selector="TextBlock.brand">
      <Setter Property="FontFamily" Value="{DynamicResource Lab.Font.Display}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.mark">
      <Setter Property="Foreground" Value="{DynamicResource Lab.Accent.Primary}" />
      <Setter Property="FontSize" Value="22" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontFamily" Value="{DynamicResource Lab.Font.Display}" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource Lab.Accent.Error}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Lab.Surface.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Lab.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="28,24" />
      <Setter Property="Width" Value="460" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource Lab.Font.Mono}" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Lab.Accent.Primary}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Lab.Surface.Canvas}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Lab.Accent.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Lab.Surface.Canvas}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Lab.Accent.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Lab.Surface.Canvas}" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Lab.Text.Secondary}" />
    </Style>
  </Application.Styles>
</Application>
