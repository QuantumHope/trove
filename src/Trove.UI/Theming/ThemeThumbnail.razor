@* A small drawing of the app in one theme, as CORA draws it: header, sidebar, a line of type in the theme's display
   face and four accents. It carries data-theme, so every colour comes from that theme's own token block. *@
<span class="theme-thumb @Class" data-theme="@Theme" aria-hidden="true">
    <span class="theme-thumb__header">
        <span class="theme-thumb__brand"></span>
        <span class="theme-thumb__nav"></span>
        <span class="theme-thumb__nav theme-thumb__nav--on"></span>
        <span class="theme-thumb__nav"></span>
    </span>
    <span class="theme-thumb__body">
        <span class="theme-thumb__side">
            <span class="theme-thumb__line theme-thumb__line--accent"></span>
            <span class="theme-thumb__line"></span>
            <span class="theme-thumb__line theme-thumb__line--short"></span>
            <span class="theme-thumb__line"></span>
        </span>
        <span class="theme-thumb__main">
            <svg class="theme-thumb__face" viewBox="0 0 32 40">
                <path class="theme-thumb__head" d="M16 2 L27 8 L30 20 L25 32 L16 38 L7 32 L2 20 L5 8 Z" />
                <path class="theme-thumb__seam" d="M5 8 L16 14 L27 8 M16 14 L16 30 M2 20 L16 30 L30 20" />
                <path class="theme-thumb__eye" d="M7 18 L10 16 L14 17 L12 20 L8 20 Z" />
                <path class="theme-thumb__eye" d="M25 18 L22 16 L18 17 L20 20 L24 20 Z" />
                <path class="theme-thumb__mouth" d="M11 29 Q16 30.5 21 29" />
            </svg>
            <span class="theme-thumb__type">Aa</span>
            <span class="theme-thumb__accents">
                <span class="theme-thumb__dot theme-thumb__dot--pink"></span>
                <span class="theme-thumb__dot theme-thumb__dot--yellow"></span>
                <span class="theme-thumb__dot theme-thumb__dot--purple"></span>
                <span class="theme-thumb__dot theme-thumb__dot--blue"></span>
            </span>
        </span>
    </span>
</span>

@code {
    [Parameter, EditorRequired] public string Theme { get; set; } = ThemeCatalog.DefaultId;
    [Parameter] public string? Class { get; set; }
}
