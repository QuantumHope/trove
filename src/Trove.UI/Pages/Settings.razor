@page "/settings"

<PageTitle>Settings · Trove</PageTitle>

<h1>Settings</h1>

<div class="trove-card">
    <h2>Theme</h2>
    <p>Trove wears the shared HopeLab themes, the same ones as CORA, OneRing and the Bench. Pick one in the header; it's kept in this browser.</p>
    <ul class="trove-theme-list">
        @foreach (var theme in ThemeCatalog.All)
        {
            <li><strong>@theme.Name</strong> <span>@theme.Description</span></li>
        }
    </ul>
</div>
