@* One video, laid out like a card on YouTube: thumbnail with its length, title, then channel, views and age. The
   thumbnail and title open the video on YouTube in a new tab. *@

<article class="trove-video" data-video="@Video.VideoId">
    <a class="trove-video-thumb" href="@Video.WatchUrl" target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
        <img src="@Video.ThumbnailUrl" alt="" loading="lazy" />
        <span class="trove-video-length">@VideoFormat.Length(Video.Duration)</span>
    </a>
    <a class="trove-video-title" href="@Video.WatchUrl" target="_blank" rel="noopener noreferrer" title="@Video.Title">@Video.Title</a>
    <p class="trove-video-meta">
        @Video.ChannelTitle
        @if (Video.ViewCount is not null)
        {
            <span> · @VideoFormat.Views(Video.ViewCount)</span>
        }
        <span> · @VideoFormat.Ago(Video.PublishedAt, Now)</span>
    </p>

    @if (Video.State.CanRate())
    {
        <StarRatingInput Value="Video.Rating" ValueChanged="rating => OnRate.InvokeAsync((Video, rating))" Label="@($"Your rating for {Video.Title}")" />
    }

    @if (Video.State == WatchState.Done && Video.WatchedOn is { } watched)
    {
        <p class="trove-video-watched">Watched @VideoFormat.Day(watched)</p>
    }

    <label class="trove-video-move">
        <span>Move to</span>
        <select value="@Video.State" @onchange="OnMoveSelected" aria-label="@($"Move {Video.Title} to")">
            @foreach (var state in WatchStates.All)
            {
                <option value="@state">@state.Label()</option>
            }
        </select>
    </label>
</article>

@code {
    [Parameter, EditorRequired] public Playthrough Video { get; set; } = default!;

    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    [Parameter] public EventCallback<(Playthrough Video, WatchState State)> OnMove { get; set; }

    [Parameter] public EventCallback<(Playthrough Video, decimal? Rating)> OnRate { get; set; }

    private Task OnMoveSelected(ChangeEventArgs e) =>
        Enum.TryParse<WatchState>(e.Value?.ToString(), out var state) && state != Video.State
            ? OnMove.InvokeAsync((Video, state))
            : Task.CompletedTask;
}
