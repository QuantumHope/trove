<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The server on the home box: serves the web app and its API, listening on localhost only so tailscale serve is the
       one way in. -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>trove-web-6f0c2a8e</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trove.Web.Client\Trove.Web.Client.csproj" />
    <ProjectReference Include="..\Trove.UI\Trove.UI.csproj" />
    <ProjectReference Include="..\Trove.Core\Trove.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Trove.Tests" />
  </ItemGroup>
</Project>
