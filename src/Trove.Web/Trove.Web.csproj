<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The server on the home box: serves the web app (and later the API), listening on localhost only so tailscale serve
       is the one way in. -->
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trove.Web.Client\Trove.Web.Client.csproj" />
    <ProjectReference Include="..\Trove.UI\Trove.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Trove.Tests" />
  </ItemGroup>
</Project>
